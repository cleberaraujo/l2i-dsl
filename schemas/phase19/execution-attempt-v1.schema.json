{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2i.local/schemas/phase19/execution-attempt-v1.schema.json",
  "title": "L2I Phase 19 isolated execution attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "materialized_unit_sha256", "campaign_id", "execution_plan_id", "block_id", "run_slot_id", "execution_id", "attempt_number", "state", "provenance", "timestamps", "invocation", "results_directory", "native_results_root", "outcome"],
  "properties": {
    "contract_version": {"const": "phase19-execution-attempt-v1"},
    "materialized_unit_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "execution_plan_id": {"type": "string", "pattern": "^execution-plan-[0-9a-f]{64}$"},
    "block_id": {"$ref": "#/$defs/identifier"},
    "run_slot_id": {"type": "string", "pattern": "^run-slot-[0-9a-f]{64}$"},
    "execution_id": {"$ref": "#/$defs/identifier"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "state": {"enum": ["MATERIALIZED", "PREFLIGHT_PASSED", "RUNNING", "SUCCEEDED", "FAILED", "INTERRUPTED"]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "branch", "worktree_clean", "origin_commit", "hostname", "user"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"const": "develop"},
        "worktree_clean": {"const": true},
        "origin_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "hostname": {"$ref": "#/$defs/identifier"},
        "user": {"$ref": "#/$defs/identifier"}
      }
    },
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["materialized_at_utc", "preflight_passed_at_utc", "running_at_utc", "completed_at_utc"],
      "properties": {
        "materialized_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "preflight_passed_at_utc": {"anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]},
        "running_at_utc": {"anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]},
        "completed_at_utc": {"anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]}
      }
    },
    "invocation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "results_directory": {"type": "string"},
    "native_results_root": {"type": "string"},
    "outcome": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["return_code", "artifact_hashes", "readbacks"],
          "properties": {
            "return_code": {"type": ["integer", "null"]},
            "artifact_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
            "readbacks": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "MATERIALIZED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"type": "null"}, "running_at_utc": {"type": "null"}, "completed_at_utc": {"type": "null"}}},
          "outcome": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "PREFLIGHT_PASSED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "running_at_utc": {"type": "null"}, "completed_at_utc": {"type": "null"}}},
          "outcome": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "RUNNING"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "running_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "completed_at_utc": {"type": "null"}}},
          "outcome": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "SUCCEEDED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "running_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "completed_at_utc": {"$ref": "#/$defs/utcTimestamp"}}},
          "outcome": {"type": "object", "properties": {"return_code": {"const": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "FAILED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "running_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "completed_at_utc": {"$ref": "#/$defs/utcTimestamp"}}},
          "outcome": {"type": "object", "properties": {"return_code": {"type": "integer", "not": {"const": 0}}}}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "INTERRUPTED"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timestamps": {"properties": {"preflight_passed_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "running_at_utc": {"$ref": "#/$defs/utcTimestamp"}, "completed_at_utc": {"$ref": "#/$defs/utcTimestamp"}}},
          "outcome": {"type": "object", "properties": {"return_code": {"type": "integer"}}}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
