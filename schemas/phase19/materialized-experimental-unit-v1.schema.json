{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l2i.local/schemas/phase19/materialized-experimental-unit-v1.schema.json",
  "title": "L2I Phase 19 materialized paired experimental unit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "execution_plan_id", "execution_plan_sha256",
    "repository_commit", "campaign_id", "randomization_manifest_id",
    "randomization_manifest_sha256", "campaign_stage", "rq_id", "scenario_id",
    "backend_mode", "block_id", "block_sequence_index", "order", "repetition",
    "configuration_id", "profile_id", "source_artifacts", "runtime_parameters",
    "slots", "materialized_unit_sha256"
  ],
  "properties": {
    "contract_version": {"const": "phase19-materialized-experimental-unit-v1"},
    "execution_plan_id": {"type": "string", "pattern": "^execution-plan-[0-9a-f]{64}$"},
    "execution_plan_sha256": {"$ref": "#/$defs/sha256"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "randomization_manifest_id": {"$ref": "#/$defs/identifier"},
    "randomization_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_stage": {"const": "pilot"},
    "rq_id": {"const": "RQ3"},
    "scenario_id": {"const": "S1"},
    "backend_mode": {"const": "mock"},
    "block_id": {"$ref": "#/$defs/identifier"},
    "block_sequence_index": {"type": "integer", "minimum": 1},
    "order": {"enum": ["AB", "BA"]},
    "repetition": {"const": 1},
    "configuration_id": {"$ref": "#/$defs/identifier"},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "source_artifacts": {
      "type": "array", "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": {"role": {"const": "scenario_spec"}}
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f\\u007f/\\\\]+(?:/[^\\u0000-\\u001f\\u007f/\\\\]+)*$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "runtime_parameters": {"$ref": "#/$defs/runtime"},
    "slots": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/slot"}, {"properties": {"period": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/slot"}, {"properties": {"period": {"const": 2}}}]}
      ],
      "items": false
    },
    "materialized_unit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["spec_path", "duration_s", "flow_mbps", "best_effort_mbps", "bandwidths_mbps", "delay_ms", "rtt_interval_ms", "rtt_samples", "bandwidth_tolerance_mbps"],
      "properties": {
        "spec_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f\\u007f/\\\\]+(?:/[^\\u0000-\\u001f\\u007f/\\\\]+)*$"},
        "duration_s": {"type": "integer", "minimum": 2},
        "flow_mbps": {"type": "number", "exclusiveMinimum": 0},
        "best_effort_mbps": {"type": "number", "exclusiveMinimum": 0},
        "bandwidths_mbps": {
          "type": "object", "additionalProperties": false, "required": ["A", "B", "C"],
          "properties": {"A": {"type": "number", "exclusiveMinimum": 0}, "B": {"type": "number", "exclusiveMinimum": 0}, "C": {"type": "number", "exclusiveMinimum": 0}}
        },
        "delay_ms": {"type": "number", "minimum": 0},
        "rtt_interval_ms": {"type": "integer", "minimum": 10},
        "rtt_samples": {"type": ["integer", "null"], "minimum": 2},
        "bandwidth_tolerance_mbps": {"type": "number", "minimum": 0}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_index", "run_slot_id", "assignment_sha256", "period", "arm", "treatment", "randomization_seed_hex", "assignment"],
      "properties": {
        "slot_index": {"type": "integer", "minimum": 1},
        "run_slot_id": {"type": "string", "pattern": "^run-slot-[0-9a-f]{64}$"},
        "assignment_sha256": {"$ref": "#/$defs/sha256"},
        "period": {"enum": [1, 2]},
        "arm": {"enum": ["A", "B"]},
        "treatment": {"enum": ["baseline", "adapt"]},
        "randomization_seed_hex": {"$ref": "#/$defs/sha256"},
        "assignment": {"type": "object"}
      }
    }
  }
}
