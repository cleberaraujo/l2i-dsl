# Canonical external dependency revisions for the L2I development line.
#
# Source dependencies are pinned to immutable Git commits recovered from the
# preserved SBRC 2026 development environment. System-package values record the
# expected upstream versions provided by Ubuntu Server 24.04 LTS. The complete
# Debian package revisions installed at runtime are captured by the provenance
# collector.

L2I_PI_REF="5689c91a8a7423781267b27d8b166c49a53904ff"
L2I_BMV2_REF="2bdd0b7b2b2ae89faf2720f2158e9842bc6d2dd2"
L2I_P4C_REF="e9540bd6d50dda4a8aae1545df7b201f28be4c9d"

# Canonical p4c backend profile for the evaluated Domain C. The experiments
# require the BMv2 backend and P4Runtime artifacts; the eBPF backend is outside
# the evaluated scope and is disabled explicitly to avoid optional libbpf/LLVM
# setup during configuration.
L2I_P4C_ENABLE_BMV2="ON"
L2I_P4C_ENABLE_EBPF="OFF"
L2I_SYSREPO_REF="5fae6f27d5de0f9d7f76cf6953871255a210e978"
L2I_LIBNETCONF2_REF="4514f16d71665a1b2c7ad29908474ef67526ed07"
L2I_NETOPEER2_REF="00ea22af3ff04b2a6978243ac485d8db18ec3b0c"

L2I_LIBYANG_UPSTREAM_VERSION="2.1.30"
L2I_PROTOBUF_UPSTREAM_VERSION="3.21.12"
L2I_GRPC_UPSTREAM_VERSION="1.51.1"
